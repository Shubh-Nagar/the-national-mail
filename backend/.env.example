# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public base URL of this API. Used to build absolute links to uploaded files.
PUBLIC_URL=http://localhost:5000
# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:3000

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=shubham
DB_NAME=tnm

# ---------- Auth ----------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=af0506dfd9044be8d56e9772cd8c5a15ada9b612de476034f8bcd643aaeb7cf277fe9b1a8b0a4c91dae7310d46eb8a00
JWT_EXPIRES_IN=7d

# Optional: npm run db:setup creates/updates this admin account.
# Leave blank to use the seeded default (admin@nationalmail.in / Admin@12345).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200
