# Public URL of the backend API (used by the browser and by the server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public URL of this website (used for canonical links, Open Graph and the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: URL the Next.js server should use to reach the API when it differs
# from the public one (e.g. inside Docker: http://backend:5000/api)
INTERNAL_API_URL=
